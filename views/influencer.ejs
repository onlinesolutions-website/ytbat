<%- include('partials/header', { user }) %>
<h2>Influencer Dashboard</h2>
<h3>Create Post</h3>
<form action="/create-post" method="POST">
  <select name="type">
    <option value="text">Text</option>
    <option value="image">Image URL</option>
    <option value="video">Video URL</option>
  </select>
  <input type="text" name="content" placeholder="Content" required>
  <button type="submit">Post</button>
</form>

<h3>Your Posts</h3>
<% posts.forEach(p => { %>
  <div class="post">
    <p><%= p.content %></p>
    <p>Hearts: <%= p.hearts %></p>
  </div>
<% }) %>

<h3>Tips Received</h3>
<% tips.forEach(t => { %>
  <div>
    <p>From fan <%= t.fanId %> - $<%= t.amount %> - "<%= t.message %>"</p>
    <% if (!t.hearted) { %>
      <form action="/tips/<%= t.id %>/heart" method="POST">
        <button type="submit">Heart Tip</button>
      </form>
    <% } else { %>
      <p>❤️</p>
    <% } %>
  </div>
<% }) %>
<%- include('partials/footer') %>
