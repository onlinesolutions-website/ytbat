<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fan Site</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<nav>
  <% if (user) { %>
    Logged in as <%= user.username %> | <a href="/logout">Logout</a>
    <% if (user.role === 'influencer') { %> | <a href="/influencer">Influencer</a> <% } %>
    <% if (user.role === 'admin') { %> | <a href="/admin">Admin</a> <% } %>
  <% } else { %>
    <a href="/login">Login</a> | <a href="/register">Register</a>
  <% } %>
</nav>
<hr>
<%- body %>
</body>
</html>
